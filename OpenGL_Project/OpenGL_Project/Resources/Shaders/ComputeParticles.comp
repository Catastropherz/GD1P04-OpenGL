#version 460 core

#define WORK_GROUP_SIZE_X 128
layout (local_size_x = WORK_GROUP_SIZE_X, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) buffer PositionLifeBuffer { vec4 PositionLife[]; }; // xyz: Pos, w: Remaining Life
layout(std430, binding = 1) buffer VelocityBuffer     { vec4 Velocity[]; };     // xyz: Vel, w: Initial MaxLife

uniform int FireworkIndex;
uniform int ParticlesPerFirework;
uniform float DeltaTime;
uniform float TrailTime;
uniform vec3 EmitterOrigin;

uniform int SeedLife;
uniform int SeedX;
uniform int SeedY;
uniform int SeedZ;

double RandomValue(uint ID, int Seed)
{
    int Noise = int(ID) * Seed;
    Noise = (Noise << 13) ^ Noise;
    int T = (Noise * (Noise * Noise * 15731 + 789221) + 1376312589) & 0x7fffffff;
    return 1.0 - double(T) * 0.93132257461548515625e-9;
}  

void InitParticle(uint Index)
{
    // Lifetime = Launch Trail Duration + Explosion Burst Duration
    float expLife = 2.0f + float(RandomValue(Index, SeedLife)) * 0.5f;
    float totalLife = TrailTime + expLife;

    PositionLife[Index] = vec4(EmitterOrigin, totalLife);

    // Generate random 3D direction
    vec3 dir = vec3(
        float(RandomValue(Index, SeedX)),
        float(RandomValue(Index, SeedY)),
        float(RandomValue(Index, SeedZ))
    );

    float len = length(dir);
    if (len < 0.001f)
    {
        dir = vec3(0.0f, 1.0f, 0.0f); // Default fallback direction
    }
    else
    {
        dir = dir / len;
    }

    float speed = 25.0f + float(RandomValue(Index, SeedLife + 5)) * 15.0f;
    
    // Store spherical explosion velocity in xyz, total life in w
    Velocity[Index] = vec4(dir * speed, totalLife);
}

void main()
{
    uint localID = gl_GlobalInvocationID.x;
    uint Index = uint(FireworkIndex * ParticlesPerFirework) + localID;

    // First frame after key press (Buffer cleared to zero on CPU)
    if (Velocity[Index].w == 0.0f)
    {
        InitParticle(Index);
        return;
    }

    if (PositionLife[Index].w < 0.0f)
    {
        return;
    }

    float currentLife = PositionLife[Index].w;
    float maxLife = Velocity[Index].w;
    float timeAlive = maxLife - currentLife;

    // STAGE 1: Upwards Launch & Rocket Trail
    if (timeAlive < TrailTime)
    {
        float upSpeed = 60.0f; // Fast upward trajectory
        PositionLife[Index].y += upSpeed * DeltaTime;
        
        // Rocket trail jitter
        PositionLife[Index].x += float(RandomValue(Index, SeedX)) * 0.08f;
        PositionLife[Index].z += float(RandomValue(Index, SeedZ)) * 0.08f;
    }
    // STAGE 2: Spherical Burst Explosion in All Directions
    else
    {
        vec3 gravity = vec3(0.0f, -9.8f, 0.0f);
        Velocity[Index].xyz += gravity * DeltaTime;
        PositionLife[Index].xyz += Velocity[Index].xyz * DeltaTime;
    }

    // Decrement lifetime
    PositionLife[Index].w -= DeltaTime;
    
    // Once particle expires, mark life as -1.0 so it stays dead
    if (PositionLife[Index].w <= 0.0f)
    {
        PositionLife[Index].w = -1.0f;
    }
}